#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2009.vpi";
S_0xae55c63cc520 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0xae55c639d5a0 .scope module, "tb_pll" "tb_pll" 3 11;
 .timescale -9 -9;
v0xae55c63f5bb0_0 .var/i "errors", 31 0;
v0xae55c63f5c90_0 .var "sys_clk", 0 0;
v0xae55c63f5d50_0 .var "sys_rst_n", 0 0;
v0xae55c63f5e20_0 .var "t1", 63 0;
v0xae55c63f5ec0_0 .var "t2", 63 0;
v0xae55c63f5fb0_0 .var "t3", 63 0;
v0xae55c63f6090_0 .net "vga_clk", 0 0, v0xae55c63f5a90_0;  1 drivers
E_0xae55c639e100 .event negedge, v0xae55c63f5a90_0;
E_0xae55c63d69f0 .event posedge, v0xae55c63f5a90_0;
S_0xae55c639d730 .scope module, "dut" "pll" 3 20, 4 17 0, S_0xae55c639d5a0;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "vga_clk";
v0xae55c63c50c0_0 .net "sys_clk", 0 0, v0xae55c63f5c90_0;  1 drivers
v0xae55c63c9490_0 .net "sys_rst_n", 0 0, v0xae55c63f5d50_0;  1 drivers
v0xae55c63f5a90_0 .var "vga_clk", 0 0;
E_0xae55c63ae7f0/0 .event negedge, v0xae55c63c9490_0;
E_0xae55c63ae7f0/1 .event posedge, v0xae55c63c50c0_0;
E_0xae55c63ae7f0 .event/or E_0xae55c63ae7f0/0, E_0xae55c63ae7f0/1;
    .scope S_0xae55c639d730;
T_0 ;
    %wait E_0xae55c63ae7f0;
    %load/vec4 v0xae55c63c9490_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0xae55c63f5a90_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xae55c63f5a90_0;
    %inv;
    %assign/vec4 v0xae55c63f5a90_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0xae55c639d5a0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xae55c63f5c90_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xae55c63f5d50_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0xae55c63f5bb0_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0xae55c639d5a0;
T_2 ;
    %delay 10, 0;
    %load/vec4 v0xae55c63f5c90_0;
    %inv;
    %store/vec4 v0xae55c63f5c90_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0xae55c639d5a0;
T_3 ;
    %vpi_call/w 3 30 "$dumpfile", "results/tb_pll.vcd" {0 0 0};
    %vpi_call/w 3 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0xae55c639d5a0 {0 0 0};
    %vpi_call/w 3 33 "$timeformat", 32'sb11111111111111111111111111110111, 32'sb00000000000000000000000000000000, " ns", 32'sb00000000000000000000000000001000 {0 0 0};
    %vpi_call/w 3 34 "$display", "=== Lab 4 pll test ===" {0 0 0};
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xae55c63f5d50_0, 0, 1;
    %delay 83, 0;
    %load/vec4 v0xae55c63f6090_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_3.0, 6;
    %load/vec4 v0xae55c63f5bb0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xae55c63f5bb0_0, 0, 32;
    %vpi_call/w 3 41 "$display", "FAIL  vga_clk=%b while reset is asserted, expected 0", v0xae55c63f6090_0 {0 0 0};
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 43 "$display", "PASS  vga_clk held at 0 while reset is asserted" {0 0 0};
T_3.1 ;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xae55c63f5d50_0, 0, 1;
    %wait E_0xae55c63d69f0;
    %vpi_func 3 49 "$time" 64 {0 0 0};
    %store/vec4 v0xae55c63f5e20_0, 0, 64;
    %wait E_0xae55c63d69f0;
    %vpi_func 3 50 "$time" 64 {0 0 0};
    %store/vec4 v0xae55c63f5ec0_0, 0, 64;
    %wait E_0xae55c63d69f0;
    %vpi_func 3 51 "$time" 64 {0 0 0};
    %store/vec4 v0xae55c63f5fb0_0, 0, 64;
    %load/vec4 v0xae55c63f5ec0_0;
    %load/vec4 v0xae55c63f5e20_0;
    %sub;
    %cmpi/ne 40, 0, 64;
    %jmp/1 T_3.4, 6;
    %flag_mov 8, 6;
    %load/vec4 v0xae55c63f5fb0_0;
    %load/vec4 v0xae55c63f5ec0_0;
    %sub;
    %cmpi/ne 40, 0, 64;
    %flag_or 6, 8;
T_3.4;
    %jmp/0xz  T_3.2, 6;
    %load/vec4 v0xae55c63f5bb0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xae55c63f5bb0_0, 0, 32;
    %load/vec4 v0xae55c63f5ec0_0;
    %load/vec4 v0xae55c63f5e20_0;
    %sub;
    %load/vec4 v0xae55c63f5fb0_0;
    %load/vec4 v0xae55c63f5ec0_0;
    %sub;
    %vpi_call/w 3 54 "$display", "FAIL  vga_clk period %0d / %0d ns, expected 40 ns", S<1,vec4,u64>, S<0,vec4,u64> {2 0 0};
    %jmp T_3.3;
T_3.2 ;
    %vpi_call/w 3 57 "$display", "PASS  vga_clk period = 40 ns (25.000 MHz)" {0 0 0};
T_3.3 ;
    %wait E_0xae55c639e100;
    %vpi_func 3 61 "$time" 64 {0 0 0};
    %load/vec4 v0xae55c63f5fb0_0;
    %sub;
    %cmpi/ne 20, 0, 64;
    %jmp/0xz  T_3.5, 6;
    %load/vec4 v0xae55c63f5bb0_0;
    %addi 1, 0, 32;
    %store/vec4 v0xae55c63f5bb0_0, 0, 32;
    %vpi_func 3 63 "$time" 64 {0 0 0};
    %load/vec4 v0xae55c63f5fb0_0;
    %sub;
    %vpi_call/w 3 63 "$display", "FAIL  vga_clk high time %0d ns, expected 20 ns", S<0,vec4,u64> {1 0 0};
    %jmp T_3.6;
T_3.5 ;
    %vpi_call/w 3 65 "$display", "PASS  vga_clk high time = 20 ns (50 %% duty)" {0 0 0};
T_3.6 ;
    %load/vec4 v0xae55c63f5bb0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.7, 4;
    %vpi_call/w 3 69 "$display", "RESULT: PASS (pll: period, duty and reset)" {0 0 0};
    %jmp T_3.8;
T_3.7 ;
    %vpi_call/w 3 71 "$display", "RESULT: FAIL (%0d errors)", v0xae55c63f5bb0_0 {0 0 0};
T_3.8 ;
    %load/vec4 v0xae55c63f5bb0_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_3.9, 4;
    %vpi_call/w 3 73 "$fatal", 32'sb00000000000000000000000000000001, "tb_pll failed" {0 0 0};
T_3.9 ;
    %vpi_call/w 3 74 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "Sim/tb_pll.v";
    "RTL/pll.v";
